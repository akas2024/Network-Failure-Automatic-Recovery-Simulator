# ============================================================
# AI Tutor Backend Configuration
# ============================================================

# Server Port (Frontend connects to this port)
PORT=5000

# Recommended: Google Gemini API Key
# Get a free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Gemini Model to use (options: gemini-flash-lite-latest, gemini-3.5-flash-lite, gemini-3.8-flash)
GEMINI_MODEL=gemini-flash-lite-latest

# Alternative: OpenAI API Key (if you prefer OpenAI)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# Optional: ngrok AuthToken (Get free token at https://dashboard.ngrok.com/get-started/your-authtoken)
# NGROK_AUTHTOKEN=your_ngrok_authtoken_here
